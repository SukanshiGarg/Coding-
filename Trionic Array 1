class Solution {
    public boolean isTrionic(int[] nums) {

        int n = nums.length;
        int i = 0;

        // Phase 1: strictly increasing
        while (i + 1 < n && nums[i] < nums[i + 1]) {
            i++;
        }

        // no increasing part
        if (i == 0 || i == n - 1) {
            return false;
        }

        // Phase 2: strictly decreasing
        int peak = i;

        while (i + 1 < n && nums[i] > nums[i + 1]) {
            i++;
        }

        // no decreasing part
        if (i == peak || i == n - 1) {
            return false;
        }

        // Phase 3: strictly increasing
        int valley = i;

        while (i + 1 < n && nums[i] < nums[i + 1]) {
            i++;
        }

        // must reach end and final increasing should exist
        return i == n - 1 && valley != i;
    }
}
