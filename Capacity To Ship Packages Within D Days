class Solution {
    public int shipWithinDays(int[] weights, int days) {
        int start=1;
        int sum=0;
        for(int i = 0; i<weights.length;i++){
            sum+=weights[i];
        }
        int end=sum;
        int ans=0;
        while(start<=end){
            int mid = start+ (end-start)/2;
            if(isValid(weights,days,mid)){
                ans=mid;
                end=mid-1;
            }
            else{
                start=mid+1;
            }
        }
        return ans;
    }
    public static boolean isValid(int weights[], int days, int mid){
        int count=1;
        int max=0;
        for(int i=0;i<weights.length;i++){
            if(weights[i]+max <= mid){
                max= max + weights[i];
            }
            else{
                count++;
                if(count>days || weights[i]>mid) return false;
                else{
                    max=0;
                    max=max+weights[i];
                }
            }
        }
        return true;
    }
}
